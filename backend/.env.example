APP_NAME=MedVoice AI
ENVIRONMENT=development

# Backend security and API settings
REQUIRE_API_KEY=false
MEDVOICE_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data layer: Docker Postgres locally, managed Postgres/Supabase later
USE_DATABASE=false
DATABASE_URL=postgresql+psycopg://medvoice:medvoice@localhost:55432/medvoice
POSTGRES_USER=medvoice
POSTGRES_PASSWORD=medvoice
POSTGRES_DB=medvoice
POSTGRES_PORT=55432
POSTGRES_HOST=localhost
SUPABASE_URL=
SUPABASE_KEY=

# LLM provider: deterministic|ollama|openai|groq|openrouter
LLM_PROVIDER=deterministic
LLM_FALLBACK_PROVIDER=deterministic
LLM_ENABLE_FALLBACK=true
LLM_TIMEOUT_SECONDS=8

# Local development LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional hosted production LLMs. Leave blank to use deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Logging
LOG_DIR=logs
LOG_REDACT_PHI=true

# Voice provider architecture
VOICE_PROVIDER=local
SARVAM_API_KEY=
SARVAM_TTS_MODEL=
SARVAM_STT_MODEL=
SARVAM_TTS_URL=https://api.sarvam.ai/v1/tts
SARVAM_STT_URL=https://api.sarvam.ai/v1/stt
SARVAM_TIMEOUT_SECONDS=12
PROVIDER_RETRY_COUNT=1
DEFAULT_LANGUAGE=en-IN
DEFAULT_VOICE_PERSONA=female_warm_indian
ENABLE_STREAMING_AUDIO=true
