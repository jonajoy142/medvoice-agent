# Supabase Auth / API. If SUPABASE_URL is blank, app config derives it from SUPABASE_HOST/SUPABASE_PORT.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Preferred database URL. SQLAlchemy driver is normalized by app config.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
USE_DATABASE=true

# Split Postgres env fallback. Typo-compatible names are also supported.
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
SUPABASE_PSWD=
SUPBASE_PORT=5432
SUPBASE_PSWD=

# Redis / app security
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Voice / AI providers
SARVAM_API_KEY=
SARVAM_STT_ENDPOINT=
SARVAM_TTS_ENDPOINT=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Telephony
TELEPHONY_PROVIDER=exotel
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_BASE_URL=https://api.exotel.com/v1/Accounts

# Guardrails / storage
SUPABASE_STORAGE_BUCKET=knowledge-base
LOW_CONFIDENCE_THRESHOLD=0.72
RAG_CONFIDENCE_THRESHOLD=0.68
EMERGENCY_ESCALATION_NUMBER=
HUMAN_HANDOFF_NUMBER=
LOG_REDACT_PHI=true

# Optional seed mapping. Create Auth users in Supabase, then provide IDs or allow service-role lookup by email.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_USER_ID=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
SEED_HOSPITAL_ADMIN_EMAIL=
SEED_HOSPITAL_ADMIN_USER_ID=
SEED_STAFF_EMAIL=
SEED_STAFF_USER_ID=
SEED_DEFAULT_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
